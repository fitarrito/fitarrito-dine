# Copy to .env.local for local development.
# Add the same variables in Vercel → Project Settings → Environment Variables
# for Production, Preview, and Development, then redeploy.

# Supabase → Settings → API
# Use the Project URL (NOT the /rest/v1/ Data API URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — used for CartItems writes (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Kitchen WhatsApp number for order notifications (wa.me link)
NEXT_PUBLIC_WHATSAPP_KITCHEN_PHONE=919600908264

# Google Maps for Other Address checkout.
# Enable Maps JavaScript API, Places API, and Geocoding API on this key.
# Restrict the key to dine.fitarrito.com and localhost.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Server-only key for geocoding and driving distance.
# Do not use an HTTP-referrer restricted key here.
# Enable Geocoding API and Routes API (or Distance Matrix API).
GOOGLE_MAPS_SERVER_API_KEY=your-server-google-maps-api-key

# Restaurant pin used as the driving-distance origin.
# Address: 3, First Floor, Ward 149, Villivakkam Block,
# Sridevi Kuppam Main Road, Valasaravakkam, Chennai 600087.
RESTAURANT_LATITUDE=
RESTAURANT_LONGITUDE=

# Razorpay Standard Checkout
# KEY_SECRET is server-only. Only KEY_ID may be public.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# Dashboard → Webhooks → https://dine.fitarrito.com/api/razorpay/webhook
# Events: payment.captured and payment.failed
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Resend (server-only — never prefix with NEXT_PUBLIC_)
RESEND_API_KEY=re_xxxxxxxx
FITARRITO_EMAIL=fitarrito@gmail.com

# Secure staff order-confirmation links (server-only)
# Generate with: openssl rand -base64 48
STAFF_ORDER_CONFIRM_SECRET=replace-with-at-least-32-random-characters
STAFF_DASHBOARD_PASSWORD=replace-with-a-staff-password
FITARRITO_APP_URL=https://dine.fitarrito.com
