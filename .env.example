# Copy to .env.local for local development.
# Add the same variables in Vercel → Project Settings → Environment Variables
# for Production, Preview, and Development, then redeploy.

# Supabase → Settings → API
# Use the Project URL (NOT the /rest/v1/ Data API URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — used for CartItems writes (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Kitchen WhatsApp number for order notifications (wa.me link)
NEXT_PUBLIC_WHATSAPP_KITCHEN_PHONE=919600908264

# Razorpay Standard Checkout
# KEY_SECRET is server-only. Only KEY_ID may be public.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Resend (server-only — never prefix with NEXT_PUBLIC_)
RESEND_API_KEY=re_xxxxxxxx
FITARRITO_EMAIL=fitarrito@gmail.com

# Secure staff order-confirmation links (server-only)
# Generate with: openssl rand -base64 48
STAFF_ORDER_CONFIRM_SECRET=replace-with-at-least-32-random-characters
FITARRITO_APP_URL=https://dine.fitarrito.com
